# Copia a .env (o configura estas variables en tu hosting). NUNCA subas el .env real.
DISCORD_TOKEN=
# Pon UNA de las dos claves (o ambas y elige con LLM_PROVIDER=gemini|claude)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Opcionales
# Modelos (por defecto el más barato; sube a claude-sonnet-5-5 si quieres más calidad)
CLAUDE_MODEL=claude-haiku-5-5
GEMINI_MODEL=gemini-2.5-flash
# Canal donde publicar el resumen semanal (clic derecho en el canal -> Copiar ID)
ANNOUNCE_CHANNEL_ID=
# Canales donde responde SIEMPRE, sin necesidad de mención (IDs separados por coma)
CHAT_CHANNEL_IDS=
# Carpeta del repo con README.md, docs/, etc. (por defecto, la carpeta superior)
KNOWLEDGE_DIR=..
